# ElevenLabs — used by `npm run gen:audio` to pre-generate
# narration MP3s for blog posts into public/audio/{slug}.mp3
#
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Default voice is "Adam" (calm, business-friendly).
# Browse voices: https://elevenlabs.io/app/voice-library
# Common picks:
#   pNInz6obpgDQGcFmaJgB  Adam       (default)
#   21m00Tcm4TlvDq8ikWAM  Rachel
#   onwK4e9ZLuTAKqWW03F9  Daniel
#   EXAVITQu4vr4xnSDxMaL  Bella
#   VR6AewLTigWG4xSOukaG  Arnold
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optional. eleven_multilingual_v2 is the highest quality general model.
# Use eleven_turbo_v2_5 for faster generation if cost matters.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# PostHog — client-side product analytics, session replay, web analytics.
# Create a free project at https://us.posthog.com → Project Settings → Project API Key.
# If your account is on EU Cloud, change HOST to https://eu.i.posthog.com.
# These are NEXT_PUBLIC_ — inlined at build time, must be set during `npm run build`
# (locally and in Cloudflare Pages → Settings → Environment Variables).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
